// hr_c04: Hive City remaster, the Uncle Pikky's hall (camera c04).
// No ReflectScale anywhere (the owner: floors were too reflective). smoothness scales the _gloss map (R smoothness,
// G metalness, both from the CC0 sets); "default" is the concrete-sound entry of materials.def.
// pxmat (2026-11-24): + ReliefScale (parallax, textures/<name>_hmap), ReflectScale on metal/glass/lamps (floors stay dry), detailmap.
"hr_c04_blocks"
{
	"material" "default"
	"smoothness" "0.3"
	"ReliefScale" "0.16"
	"detailmap" "textures/detail/pxd_concrete"
	"detailScale" "4"
}
"hr_c04_floor"
{
	"material" "default"
	"smoothness" "0.25"
	"ReliefScale" "0.05"
	"detailmap" "textures/detail/pxd_floor"
	"detailScale" "8"
}
"hr_c04_pillar"
{
	"material" "metal"
	"smoothness" "0.6"
	"ReliefScale" "0.06"
	"ReflectScale" "0.6"
	"detailmap" "textures/detail/pxd_metal"
	"detailScale" "8"
}
"hr_c04_ceil"
{
	"material" "metal"
	"smoothness" "0.45"
	"ReliefScale" "0.06"
	"ReflectScale" "0.35"
	"detailmap" "textures/detail/pxd_metal"
	"detailScale" "8"
}
"hr_c04_frame"
{
	"material" "metal"
	"smoothness" "0.45"
	"ReliefScale" "0.06"
	"ReflectScale" "0.6"
	"detailmap" "textures/detail/pxd_metal"
	"detailScale" "4"
}
"hr_c04_grille"
{
	"material" "metal"
	"smoothness" "0.4"
	"ReliefScale" "0.06"
}
"hr_c04_neon"
{
	"material" "glass"
	"ReflectScale" "0.5"
}
