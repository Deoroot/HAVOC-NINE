+/*
+=================
+CMenuVidOptions::SetRendererMode
+
+H9: with r_primext 1 (as the page shows it) Smooth edges drives gl_msaa_samples, 0 or 4, which applies at the next
+start, and Glow drives px_bloom, which the quality presets set too. With 0 they drive H9's ref_gl cvars, r_scene_msaa
+and r_bloom, as before. Each relink reads the cvar again.
+=================
+*/
+void CMenuVidOptions::SetRendererMode( bool primextMode )
+{
+	m_bPrimextMode = primextMode;
+
+	if( primextMode )
+	{
+		smooth.szName = L( "Smooth edges (next start)" );
+		SET_EVENT_MULTI( smooth.onCvarGet,
+		{
+			CMenuCheckBox *cb = (CMenuCheckBox *)pSelf;
+			cb->SetOriginalValue( EngFuncs::GetCvarFloat( "gl_msaa_samples" ) >= 2.0f ? 1.0f : 0.0f );
+			cb->bChecked = cb->CvarValue() != 0.0f;
+		});
+		SET_EVENT_MULTI( smooth.onCvarWrite,
+		{
+			CMenuCheckBox *cb = (CMenuCheckBox *)pSelf;
+			const float samples = cb->bChecked ? 4.0f : 0.0f;
+			if( ( EngFuncs::GetCvarFloat( "gl_msaa_samples" ) >= 2.0f ) != cb->bChecked )
+				EngFuncs::CvarSetValue( "gl_msaa_samples", samples );
+		});
+		smooth.LinkCvar( "gl_msaa_samples" );
+
+		bloom.szName = L( "Glow" );
+		bloom.LinkCvar( "px_bloom" );
+	}
+	else
+	{
+		smooth.szName = L( "Smooth edges" );
+		smooth.onCvarGet.Reset();
+		smooth.onCvarWrite.Reset();
+		smooth.LinkCvar( "r_scene_msaa" );
+
+		bloom.szName = L( "Glow of magic" );
+		bloom.LinkCvar( "r_bloom" );
+	}
+
+	quality.SetGrayed( !primextMode );
+	quality.SetInactive( !primextMode );
+}
+
+// the player picked a preset: Glow shows what the preset gives px_bloom (low 0, medium and high 1)
+void CMenuVidOptions::QualityChanged()
+{
+	if( m_bSyncing || !m_bPrimextMode )
+		return;
+	const int level = (int)quality.GetCurrentValue();
+	if( level >= 0 && level <= 2 )
+	{
+		bloom.bChecked = level > 0;
+		bloom.SetCvarValue( bloom.bChecked ? 1.0f : 0.0f );
+	}
+}
+
+// the player set Glow by hand: the preset becomes custom, as client.dll would make it
+void CMenuVidOptions::GlowChanged()
+{
+	if( m_bSyncing || !m_bPrimextMode )
+		return;
+	if( quality.GetCurrentValue() != 3.0f )
+		quality.SetCurrentValue( 3.0f );
+}
