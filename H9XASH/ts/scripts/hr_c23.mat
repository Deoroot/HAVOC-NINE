// hr_c23: Hive City remaster, the brown counter room (camera c23).
// No ReflectScale anywhere: floors and walls stay dry. smoothness scales the _gloss map (R smoothness, G metalness from
// the CC0 sets); "default" is the concrete-sound entry of materials.def. Low smoothness on the floor: no shine.
// pxmat (2026-11-24): + ReliefScale (parallax, textures/<name>_hmap), ReflectScale on metal/glass/lamps (floors stay dry), detailmap.
"hr_c23_wallup"
{
	"material" "metal"
	"smoothness" "0.4"
	"ReliefScale" "0.07"
	"ReflectScale" "0.35"
	"detailmap" "textures/detail/pxd_concrete"
	"detailScale" "8"
}
"hr_c23_walllo"
{
	"material" "metal"
	"smoothness" "0.35"
	"ReliefScale" "0.07"
	"ReflectScale" "0.35"
	"detailmap" "textures/detail/pxd_concrete"
	"detailScale" "4"
}
"hr_c23_floor"
{
	"material" "default"
	"smoothness" "0.25"
	"ReliefScale" "0.05"
	"detailmap" "textures/detail/pxd_floor"
	"detailScale" "8"
}
"hr_c23_desk"
{
	"material" "wood"
	"smoothness" "0.4"
}
"hr_c23_pipe"
{
	"material" "metal"
	"smoothness" "0.55"
	"ReflectScale" "0.6"
}
"hr_c23_ceil"
{
	"material" "metal"
	"smoothness" "0.35"
	"ReliefScale" "0.06"
	"ReflectScale" "0.35"
	"detailmap" "textures/detail/pxd_metal"
	"detailScale" "4"
}
