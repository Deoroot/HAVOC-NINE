// hr_c14: Hive City remaster, the red neon stairs and the HEAVEN SENT sign between the pillars (camera c14), lower city level.
// No ReflectScale anywhere (the owner: floors were too reflective; the perforated treads kept at a low smoothness).
// smoothness scales the _gloss map (R smoothness, G metalness); "default" is the concrete-sound entry of materials.def.
"hr_c14_wall"
{
	"material" "default"
	"smoothness" "0.25"
}
"hr_c14_wallb"
{
	"material" "default"
	"smoothness" "0.25"
}
"hr_c14_tread"
{
	"material" "metal"
	"smoothness" "0.2"
}
"hr_c14_pillar"
{
	"material" "metal"
	"smoothness" "0.3"
}
"hr_c14_under"
{
	"material" "metal"
	"smoothness" "0.25"
}
"hr_c14_rail"
{
	"material" "metal"
	"smoothness" "0.3"
}
"hr_c14_trim"
{
	"material" "metal"
	"smoothness" "0.35"
}
"hr_c14_ceil"
{
	"material" "metal"
	"smoothness" "0.3"
}
"hr_c14_sign"
{
	"material" "glass"
	"smoothness" "0.05"
}
