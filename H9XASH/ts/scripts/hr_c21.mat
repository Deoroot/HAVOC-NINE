// hr_c21: Hive City remaster, the walled garden with the big tree (camera c21).
// No ReflectScale anywhere (the owner: floors were too reflective); the paving low in smoothness. smoothness scales the _gloss map.
"hr_c21_pave"
{
	"material" "default"
	"smoothness" "0.12"
}
"hr_c21_brick"
{
	"material" "default"
	"smoothness" "0.1"
}
"hr_c21_cap"
{
	"material" "default"
	"smoothness" "0.1"
}
"hr_c21_grass"
{
	"material" "default"
	"smoothness" "0.05"
}
"hr_c21_trim"
{
	"material" "metal"
	"smoothness" "0.35"
}
