// hr_c16: Hive City remaster, the sunken courtyard with the neon bar (camera c16).
// No ReflectScale anywhere (the owner: floors were too reflective); the paving low in smoothness. smoothness scales the _gloss map
// (R smoothness, G metalness); "default" is the concrete-sound entry of materials.def. The neon signs are additive (rendermode 5) and glow by their texture.
// pxmat (2026-11-24): + ReliefScale (parallax, textures/<name>_hmap), ReflectScale on metal/glass/lamps (floors stay dry), detailmap.
"hr_c16_walk"
{
	"material" "default"
	"smoothness" "0.15"
	"ReliefScale" "0.06"
	"detailmap" "textures/detail/pxd_floor"
	"detailScale" "8"
}
"hr_c16_flag"
{
	"material" "default"
	"smoothness" "0.15"
}
"hr_c16_rib"
{
	"material" "default"
	"smoothness" "0.2"
	"ReliefScale" "0.06"
	"detailmap" "textures/detail/pxd_concrete"
	"detailScale" "8"
}
