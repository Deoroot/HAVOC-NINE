{
	"material" "default"
	"smoothness" "0.12"
}
"hr_c15_wall"
{
	"material" "default"
	"smoothness" "0.15"
}
"hr_c15_curb"
{
	"material" "default"
	"smoothness" "0.12"
}
"hr_c15_grass"
{
	"material" "default"
	"smoothness" "0.05"
}
"hr_c15_trim"
{
	"material" "metal"
	"smoothness" "0.35"
}
